# Dicey Shoes — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER put the service_role key in a NEXT_PUBLIC_ var.

# Safe to expose to the browser (RLS-protected, publishable/anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://mmazwydwswrkqgisotyt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-sb_publishable-key

# Server-only, SECRET. Required. shoe_products' public RLS policy only
# exposes status='PUBLISHED' rows (all 1,000 current rows are DRAFT),
# and several tables (shoe_colorways, shoe_product_media,
# shoe_supplier_products, shoe_supplier_product_images,
# shoe_supplier_variants, shoe_supplier_variant_inventory,
# shoe_suppliers, and more) have RLS enabled with NO public read
# policy. The server-only data layer (lib/data/products.ts,
# supplier.ts, releases.ts, search.ts) uses this key via
# lib/supabase/admin.ts to read that data, then hand-picks only
# storefront-safe fields before anything reaches a component.
#
# NEVER prefix this NEXT_PUBLIC_. NEVER import lib/supabase/admin.ts
# from a "use client" file, a React context, or anything bundled to
# the browser. NEVER commit the real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Demo-mode allowlist (see lib/utils/availability.ts). Comma-separated
# master_product_id values that are allowed to be walked through
# add-to-bag -> checkout preview even though they have no verified
# sellable supplier offer. Clearly labeled "DEMO PURCHASE" in the UI.
# Leave empty to disable demo purchases entirely.
NEXT_PUBLIC_DEMO_PRODUCT_IDS=1,3,101,301,201,901,410,518,606,801

# Set to "true" to show clearly-labeled EDITORIAL PLACEHOLDER news articles
# in the News section during local development only. Must stay unset/false
# in any deployed environment until a real news source is connected.
NEWS_DEV_PLACEHOLDERS=false
