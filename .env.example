# Instagram automation — see docs/instagram-automation.md
# Copy to .env.local for local runs. In CI, IG_USER_ID and IG_ACCESS_TOKEN are repository
# secrets and the rest are repository variables. Never commit real values.

# Instagram professional account id (not the @handle)
IG_USER_ID=
# Long-lived access token with instagram_business_basic, instagram_business_content_publish,
# instagram_business_manage_comments and instagram_business_manage_insights
IG_ACCESS_TOKEN=

# Optional
# IG_API_BASE=https://graph.instagram.com     # https://graph.facebook.com for Facebook Login
# IG_GRAPH_VERSION=v23.0
# IG_REEL_MAX_SECONDS=90
# IG_HANDLE=@diceyshoes
# IG_SUPPORT_WHATSAPP=+1 548 538 2258
# IG_TIMEOUT_MS=20000
